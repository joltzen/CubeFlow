QMainWindow {
    background-color: #f5f5f5;
}

QLabel#scrambleLabel {
    color: #222222;
    font-size: 24px;
    font-weight: bold;

    padding: 16px;

    border: 1px solid #cccccc;
    border-radius: 8px;

    background-color: white;
}

QPushButton#nextButton {
    color: #222222;
    font-size: 16px;

    padding: 10px 24px;

    border: 1px solid #cccccc;
    border-radius: 6px;

    background-color: white;
}

QPushButton#nextButton:hover {
    background-color: #eeeeee;
}