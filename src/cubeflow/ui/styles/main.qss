QMainWindow {
    background-color: #f5f5f5;
}

QLabel#scrambleLabel {
    color: #222222;
    font-size: 24px;
    font-weight: bold;

    padding: 16px;

    border: 1px solid #cccccc;
    border-radius: 8px;

    background-color: white;
}

QPushButton#nextButton, QPushButton#prevButton {
    color: #222222;
    font-size: 16px;

    padding: 10px 24px;

    border: 1px solid #cccccc;
    border-radius: 6px;

    background-color: white;
}

QPushButton#nextButton:hover, QPushButton#prevButton:hover {
    background-color: #eeeeee;
}

QPushButton#nextButton:disabled, QPushButton#prevButton:disabled {
    color: #aaaaaa;
    background-color: #f5f5f5;
}

QLabel#statusLabel {
    color: #222222;
    font-size: 16px;
    padding: 4px;
}