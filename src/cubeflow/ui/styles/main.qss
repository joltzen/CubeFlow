* {
    font-family: -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

QMainWindow {
    background-color: #1b1c22;
}

QWidget#centralWidget {
    background-color: #1b1c22;
}

/* Scramble card */

QWidget#scrambleCard {
    background-color: #24252e;
    border: 1px solid #33343f;
    border-radius: 14px;
}

QLabel#scrambleLabel {
    color: #f2f2f7;
    font-size: 22px;
    font-weight: 600;
    font-family: "SF Mono", "Menlo", "Consolas", monospace;

    padding: 20px;
}

/* Status line */

QLabel#statusLabel {
    color: #9a9ba8;
    font-size: 15px;
    font-weight: 500;
    padding: 2px;
}

QLabel#statusLabel[state="done"] {
    color: #4ade80;
    font-weight: 600;
}

/* Progress bar */

QProgressBar#stepProgress {
    background-color: #24252e;
    border: none;
    border-radius: 4px;
    height: 8px;
}

QProgressBar#stepProgress::chunk {
    background-color: #00e5ff;
    border-radius: 4px;
}

/* Buttons */

QPushButton#nextButton {
    color: #06232a;
    font-size: 15px;
    font-weight: 600;

    padding: 12px 30px;

    border: none;
    border-radius: 10px;

    background-color: #00e5ff;
}

QPushButton#nextButton:hover {
    background-color: #33ebff;
}

QPushButton#nextButton:pressed {
    background-color: #00b8cc;
}

QPushButton#nextButton:disabled {
    color: #5b5c66;
    background-color: #2a2b33;
}

QPushButton#prevButton {
    color: #d0d1db;
    font-size: 15px;
    font-weight: 600;

    padding: 12px 30px;

    border: 1px solid #3a3b46;
    border-radius: 10px;

    background-color: transparent;
}

QPushButton#prevButton:hover {
    background-color: #2a2b36;
    border-color: #4a4b58;
}

QPushButton#prevButton:pressed {
    background-color: #202128;
}

QPushButton#prevButton:disabled {
    color: #55565f;
    border-color: #2a2b33;
}

QPushButton#newScrambleButton {
    color: #9a9ba8;
    font-size: 13px;
    font-weight: 600;

    padding: 8px 20px;

    border: none;
    border-radius: 8px;

    background-color: transparent;
}

QPushButton#newScrambleButton:hover {
    color: #d0d1db;
    background-color: #24252e;
}

QPushButton#newScrambleButton:pressed {
    background-color: #1e1f26;
}

QPushButton#newScrambleButton:disabled {
    color: #45464f;
}

QPushButton#autoScrambleButton {
    color: #9a9ba8;
    font-size: 13px;
    font-weight: 600;

    padding: 8px 20px;

    border: none;
    border-radius: 8px;

    background-color: transparent;
}

QPushButton#autoScrambleButton:hover {
    color: #d0d1db;
    background-color: #24252e;
}

QPushButton#autoScrambleButton:pressed {
    background-color: #1e1f26;
}

QPushButton#autoScrambleButton:disabled {
    color: #45464f;
}

QPushButton#autoScrambleButton[active="true"] {
    color: #ff6b6b;
}

QPushButton#autoScrambleButton[active="true"]:hover {
    background-color: #2e2023;
}

/* Speed control */

QLabel#speedCaption {
    color: #9a9ba8;
    font-size: 13px;
    font-weight: 500;
}

QLabel#speedLabel {
    color: #d0d1db;
    font-size: 13px;
    font-weight: 600;
}

QSlider#speedSlider::groove:horizontal {
    background-color: #2a2b33;
    height: 4px;
    border-radius: 2px;
}

QSlider#speedSlider::sub-page:horizontal {
    background-color: #00e5ff;
    height: 4px;
    border-radius: 2px;
}

QSlider#speedSlider::handle:horizontal {
    background-color: #f2f2f7;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider#speedSlider::handle:horizontal:hover {
    background-color: #ffffff;
}
